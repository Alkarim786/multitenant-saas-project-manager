# Copy to .env. Every value here is for local development only; replace them all in production.
DJANGO_SECRET_KEY=change-me-to-at-least-50-random-characters-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_PASSWORD=change-me-postgres
# Password of the unprivileged pm_app role the app connects as (row-level security applies to it).
APP_DB_PASSWORD=change-me-app
# Password given to the demo users by `manage.py seed`.
SEED_PASSWORD=change-me-demo
AUTH_THROTTLE=20/min
